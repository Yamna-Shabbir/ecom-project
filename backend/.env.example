NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gulkaar

# Comma-separated frontend origins allowed by CORS (production)
CLIENT_URL=http://localhost:3000

# Set true to serve frontend/build from this server (single-service deploy)
# SERVE_CLIENT=false

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# AI provider: "xai" or "openai"
AI_PROVIDER=openai
XAI_API_KEY=xai-your-xai-key-here
XAI_MODEL=grok-4-1-fast-non-reasoning

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Gulkaar <yourgmail@gmail.com>"

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
